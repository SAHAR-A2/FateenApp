DATABASE_URL=postgresql://user:password@127.0.0.1:5432/fateen
APP_ENV=development
APP_NAME=Fateen Backend
AGENT_DRY_RUN=true
AGENT_INGEST_API_KEY=

# Firebase Admin SDK service-account credential (path to JSON key file).
# Required for POST .../compatibility and .../alternatives to accept any
# request -- without it, require_authenticated_user rejects every call
# with 401 regardless of the token sent. See app/core/auth.py.
GOOGLE_APPLICATION_CREDENTIALS=

# CORS (comma-separated origins, no wildcard in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# LLM Provider: openai | anthropic | ollama | gemini
# Gemini is used for structured data EXTRACTION only; it NEVER decides
# safe/unsafe, compatible/incompatible, allergen risk, health risk, or
# final suitability. Those decisions stay in the database + rules +
# evidence + confidence calculations.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307
OLLAMA_MODEL=llama3.2
LLM_TIMEOUT=30.0

# Gemini (extraction provider). Set LLM_PROVIDER=gemini to use it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=30.0

# Groq (OpenAI-compatible provider). Set LLM_PROVIDER=groq to use it.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Web Discovery (deterministic source ranking; never LLM-decided).
# none = no-op (default). static = read comma-separated URLs from
# WEB_DISCOVERY_STATIC_URLS (optionally per-URL tagged as
# https://host/path|MANUFACTURER|REGULATORY|DATABASE).
# No provider is enabled until its credentials are configured; a disabled
# provider fabricates nothing.
WEB_DISCOVERY_PROVIDER=none
WEB_DISCOVERY_STATIC_URLS=
WEB_DISCOVERY_MAX_RESULTS=10

# Collector auto-extraction: when true, scan_company fetches each candidate's
# source_url through the SSRF-safe retrieval module and runs
# retrieval -> LLM -> extract_from_llm_response -> validation.
# Default false preserves the manual raw_data path exactly.
COLLECTOR_AUTO_EXTRACTION=false

# SFDA Registered Food Products API (official regulatory source).
# The adapter refuses to send ANY network request until one mechanism is
# usable; credentials are resolved in this order:
#   1. SFDA_ACCESS_TOKEN - a pre-minted 24-hour bearer token, used as-is.
#   2. SFDA_CONSUMER_KEY + SFDA_CONSUMER_SECRET + SFDA_OAUTH_TOKEN_URL -
#      OAuth2 client_credentials exchange (token URL from the developer
#      portal's Authentication/Tokens page; it is NOT guessed here).
#   3. SFDA_API_KEY (+ SFDA_API_KEY_HEADER) - FIRS open-data services.
# Never commit real credentials. Empty values are safe: nothing is sent.
SFDA_ACCESS_TOKEN=
SFDA_CONSUMER_KEY=
SFDA_CONSUMER_SECRET=
# SFDA_OAUTH_TOKEN_URL=https://example.sfda.gov.sa/oauth2/token
SFDA_OAUTH_TOKEN_URL=
SFDA_OAUTH_SCOPE=
SFDA_API_KEY=
SFDA_API_KEY_HEADER=X-API-Key
SFDA_BASE_URL=https://apis.sfda.gov.sa:9002
SFDA_PRODUCTS_PATH=/v2/Food
SFDA_FIRS_PATH=/v2/FIRS/food
SFDA_TIMEOUT=30.0
