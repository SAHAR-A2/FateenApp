rules_version = '2';

// The app keeps one document per user, users/{uid}: the profile with the
// user's allergies and chronic diseases, and their favourites. It is health
// data, so a signed-in user may read and write only their own document, and
// nothing else in the database is readable or writable from the app.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
